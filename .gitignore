# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/dist
/node_modules
/platforms
/plugins
/www

# .NET build output
bin/
obj/

# Documentacion interna / SDD
docs/SDD_Multitenant_Vargas.md
SDD*.md
*SDD*.md

# Android signing
android/keystore.properties
*.jks
*.keystore
keystore/
android/app/release/

# Firebase / Google services
google-services*.json
**/google-services.json
**/firebase-adminsdk-*.json
**/ServiceAccountKey.json

# Env files
.env
.env.local
.env.*.local
.env.release